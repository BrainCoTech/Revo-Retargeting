  <version>0.1.0</version>
  <description>Messages for Revo3 MIT command controllers.</description>
  <maintainer email="dev@brainco.cn">BrainCo</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://www.brainco-hz.com/docs/revolimb-hand/</url>
  <url type="repository">https://github.com/BrainCoTech/brainco_revo3_ros2</url>
  <url type="bugtracker">https://github.com/BrainCoTech/brainco_revo3_ros2/issues</url>
  <author email="dev@brainco.cn">BrainCo</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
